{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "extends": [
        "helpers:pinGitHubActionDigests"
      ],
      "extractVersion": "^(?<version>v?\\d+\\.\\d+\\.\\d+)$",
      "versioning": "regex:^v?(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "aya",
        "aya-build",
        "aya-ebpf"
      ],
      "groupName": "aya crates"
    },
    {
      "description": "aya-obj must match the version aya depends on; whoever bumps aya also raises this bound and checks that cargo tree -d shows no duplicate aya-obj.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "aya-obj"
      ],
      "allowedVersions": "<0.7"
    },
    {
      "description": "Hold the aarch64 zigbuild nightly: later nightlies pass -mfix-cortex-a53-843419, which zig 0.15.2 rejects. Remove this rule, and bump the pin by hand, once a cargo-zigbuild release filters that flag.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchDepNames": [
        "rust"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yaml",
        ".github/workflows/delivery.yaml"
      ],
      "enabled": false
    }
  ]
}
